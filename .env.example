# MapKit JS developer token. Copy this file to .env.local and fill it in; Vite only exposes
# variables prefixed with VITE_ to the browser. Restart the dev server after changing it.
#
# The token is an ES256 JWT signed with a MapKit JS private key from your Apple Developer
# account -- see the "Apple Maps setup" section of README.md.
VITE_MAPKIT_TOKEN=
